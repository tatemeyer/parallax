[Unit]
Description=Parallax probe — serves this machine's platform state on loopback
Documentation=https://github.com/tatemeyer/parallax

# Deliberately NOT tied to graphical-session.target, which is how SESH's
# own unit is wired. `seshd` needs WAYLAND_DISPLAY because it puts things
# on a television; the probe draws nothing and answers a cockpit that may
# be in another room. Binding it to the graphical session would stop it
# the moment the TV session ended, which is exactly when you are most
# likely to be looking at this machine from somewhere else.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# A **user** unit, like seshd, because the projects it scans live in this
# user's home and a root daemon reading them would be the wrong identity.
# That means it needs lingering enabled, or it starts at login and stops
# at logout:
#
#     sudo loginctl enable-linger $USER
#
# Without that line the Pi answers only while somebody is logged in,
# which is the failure that looks exactly like a network problem.
# `--projects-root` is the one line that differs per machine, and it is
# wrong by default on at least one of them. It names the directory whose
# *immediate children* hold a `parallax.yaml`.
#
#   desktop / laptop:  %h/Dev      — checkouts live in a Dev directory
#   the Pi:            %h          — SESH is cloned to ~/sesh, and the
#                                    probe alongside it to ~/parallax,
#                                    so the home directory is the root
#
# A wrong path is not an error: the probe starts and serves an empty
# machine, which looks exactly like a machine with nothing registered.
# Check it with `curl -s 127.0.0.1:8737/state` before walking away.
#
# `--allow-control` is deliberately absent, and adding it is a decision
# rather than a default. Without it this machine can be *looked at* from
# the tailnet; with it, anyone who can reach the probe can merge, push,
# and start agent runs here. The probe with no flag builds no executors
# at all, so the refusal is the absence of a capability rather than a
# check in front of one.
#
# If you do add it, read the two lines about ProtectHome below first.
ExecStart=%h/.local/bin/parallax-probe \
  --projects-root %h/Dev \
  --port 8737

# The GitHub token, if this machine holds private repositories. Kept out
# of the unit file so the unit can be committed and the token cannot:
#     mkdir -p %h/.config/parallax
#     printf 'GITHUB_TOKEN=ghp_...\n' > %h/.config/parallax/probe.env
#     chmod 600 %h/.config/parallax/probe.env
# Optional: without it a private repo's work feed degrades to a 404,
# which the cockpit shows honestly rather than hiding.
EnvironmentFile=-%h/.config/parallax/probe.env

Restart=always
RestartSec=5

# It binds loopback, reads a few directories, and talks to GitHub. None
# of that needs anything else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_INET6

# **`--allow-control` needs this relaxed.** A ruling is appended to
# <project>/.plumb/rulings.jsonl and a capture writes artifacts, both
# under this user's home — and `ProtectHome=read-only` makes every one
# of them fail with a permission error that names systemd nowhere and
# reads, from the cockpit two rooms away, like the action itself was
# rejected. Swap the line above for these two, narrowed to the tree the
# probe actually serves:
#
#   ProtectHome=tmpfs
#   ReadWritePaths=%h/Dev
#
# A read-only probe should keep the stricter line. It is the one that
# makes "this machine can only be looked at" true of the process as well
# as of its routes.

[Install]
WantedBy=default.target
